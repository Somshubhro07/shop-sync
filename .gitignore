
---

### `.gitignore`

```gitignore
# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build output
dist/
build/
client/build/

# Environment variables
.env
.env.local
.env.development
.env.production

# Logs
*.log
npm-debug.log*

# OS generated files
.DS_Store
Thumbs.db

# IDE/Editor files
.idea/
*.sublime-project
*.sublime-workspace
.vscode/

# MongoDB database files (if local)
data/
db/

# Miscellaneous
*.pem
*.key
*.crt

# Dependency directories
jspm_packages/

# TypeScript cache
*.tsbuildinfo